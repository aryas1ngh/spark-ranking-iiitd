# Per-machine SECRET_KEY, minted on first boot by backend/settings.py. Never
# commit this — a shared secret key is a forgeable-signature bug.
backend/.secret_key

# Data checkpoints
data/irins_checkpoint.json

# CSRankings CSV cache + PID resolver internal cache (regenerated by resolve_pids.py)
data/csrankings.csv
data/*_pid_cache.json
# Raw DBLP fetch checkpoint (regenerated by fetch_publications.py)
data/dblp_fetch_cache.json
# Half-written files left behind if an atomic write is killed mid-run
data/*.tmp

# Monthly refresh run logs + per-run history (regenerated); overrides file is tracked
pipeline/logs/
data/review_log.md

# Reference repos
frontend_ref/
spark-ranking-iiitd-SA/

# Per-institution resolver debug outputs (--institution mode); the committed
